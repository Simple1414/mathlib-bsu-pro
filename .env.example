# Copy to .env and fill in real values. Never commit .env.
# Нусха гиред ба .env ва қиматҳои воқеиро гузоред. .env-ро ба git илова накунед.

# --- Core ---
DEBUG=False
# At least 32 random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_HOSTS=your-domain.tj,www.your-domain.tj,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://your-domain.tj,https://www.your-domain.tj

# --- Database (PostgreSQL) ---
DB_NAME=mathlib_bsu
DB_USER=mathlib_user
DB_PASSWORD=strong_password_here
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- HTTPS (behind nginx) ---
BEHIND_PROXY=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Start with 3600; raise to 31536000 once HTTPS is confirmed stable.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- Media ---
# False in production: nginx serves covers/avatars; book files go through Django views.
SERVE_MEDIA_FILES=False

# --- Logging ---
LOG_LEVEL=INFO
