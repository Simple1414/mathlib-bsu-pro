{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "ponytail@ponytail": true
  },
  "permissions": {
    "allow": [
      "Bash(python manage.py check:*)",
      "Bash(python manage.py test:*)",
      "Bash(python manage.py showmigrations:*)",
      "Bash(python manage.py makemigrations --check:*)",
      "Bash(python manage.py makemigrations --dry-run:*)",
      "Bash(python manage.py sqlmigrate:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format --check:*)",
      "Bash(pyright:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(python manage.py migrate:*)",
      "Bash(python manage.py flush:*)",
      "Bash(python manage.py createsuperuser:*)",
      "Bash(git push:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(docker:*)",
      "Bash(psql:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.prod)",
      "Read(./.env.production)",
      "Read(./.env.local)",
      "Edit(./.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Bash(python manage.py reset_db:*)",
      "Bash(dropdb:*)"
    ]
  }
}
