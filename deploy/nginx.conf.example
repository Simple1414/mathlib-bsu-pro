# MathLib BSU Pro — nginx site config.
# 1) Replace your-domain.tj. 2) Get a certificate:
#    sudo certbot certonly --webroot -w /var/www/html -d your-domain.tj -d www.your-domain.tj
# 3) sudo nginx -t && sudo systemctl reload nginx

upstream mathlib_app {
    server 127.0.0.1:8001;
}

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.tj www.your-domain.tj;

    # Let's Encrypt HTTP-01 challenge
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name your-domain.tj www.your-domain.tj;

    ssl_certificate     /etc/letsencrypt/live/your-domain.tj/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.tj/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # Must be >= the 50 MB upload limit in library/models.py
    client_max_body_size 60M;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location /static/ {
        alias /var/www/mathlib_bsu_pro/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Public media only: covers and avatars.
    location ~ ^/media/(covers|article_covers|avatars)/ {
        root /var/www/mathlib_bsu_pro;
        expires 7d;
        add_header X-Content-Type-Options nosniff always;
    }

    # Book and article files must go through Django's permission-checked
    # preview/download views. Never serve them directly.
    location /media/ {
        return 404;
    }

    location / {
        proxy_pass http://mathlib_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_redirect off;
    }
}
