[Unit]
Description=MathLib BSU Gunicorn Service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/mathlib_bsu_pro
Environment="PATH=/var/www/mathlib_bsu_pro/.venv/bin"
ExecStart=/var/www/mathlib_bsu_pro/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8001 --workers 3

[Install]
WantedBy=multi-user.target
