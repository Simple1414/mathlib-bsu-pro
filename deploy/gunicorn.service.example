# /etc/systemd/system/mathlib.service
# sudo systemctl daemon-reload && sudo systemctl enable --now mathlib
[Unit]
Description=MathLib BSU Gunicorn Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/mathlib_bsu_pro
# Settings are read from /var/www/mathlib_bsu_pro/.env (chmod 600, owner www-data).
Environment="PATH=/var/www/mathlib_bsu_pro/.venv/bin"
ExecStart=/var/www/mathlib_bsu_pro/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8001 \
    --workers 3 \
    --timeout 120 \
    --max-requests 1000 --max-requests-jitter 100 \
    --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
